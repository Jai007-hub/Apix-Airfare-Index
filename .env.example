# Copy to .env and adjust as needed. All variables are optional -- sensible
# defaults let the prototype run with zero configuration.

# SQLite by default. Point at Postgres for a production-like deployment, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/apix
DATABASE_URL=sqlite:///./apix.db

# scraper/scheduler.py: "live" runs the real Scrapy spiders daily, "synthetic"
# (default) backfills one more day of calibrated synthetic data daily.
APIX_SCRAPE_MODE=synthetic
APIX_SCHEDULE_HOUR=3
APIX_SCHEDULE_MINUTE=0

# Comma-separated proxy URLs to enable scraper.middlewares.ProxyRotationMiddleware.
# Left empty by default -- no proxies are bundled with this prototype.
HTTP_PROXY_LIST=

SCRAPY_LOG_LEVEL=INFO
